{
  "name": "cnbc-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"tsc -p tsconfig.electron.json --watch\" \"wait-on tcp:5173 dist-electron/main.js && electron .\"",
    "build": "tsc --noEmit && tsc -p tsconfig.electron.json && vite build && electron-builder",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "cheerio": "^1.0.0",
    "electron-store": "^10.0.1",
    "lucide-react": "^0.468.0",
    "p-limit": "^6.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^5.0.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "local.cnbc-dashboard",
    "productName": "Stock Dashboard",
    "files": [
      "dist/**",
      "dist-electron/**",
      "electron/preload.cjs",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    }
  },
  "description": "Desktop stock watchlist dashboard: scrapes CNBC quote pages, configurable columns, user-defined formula columns.",
  "license": "MIT"
}
